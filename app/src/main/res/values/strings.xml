    <!-- Onboarding & Guardrail Disclosures -->
    <string name="onboarding_title">Setup Your Phone Guardian</string>
    <string name="onboarding_subtitle">Owner-consented anti-theft protection for your own personal device</string>
    <string name="onboarding_welcome_desc">Mobile Chor is designed solely to protect your own device against theft or accidental loss. It enforces strict owner authentication and respects Android security boundaries.</string>
    
    <string name="disclosure_guardrail_title">Important Security &amp; Legal Notice</string>
    <string name="disclosure_guardrail_1">• Mobile Chor is NOT covert stalkerware. It operates with a persistent foreground status and cannot be hidden from the device owner.</string>
    <string name="disclosure_guardrail_2">• Remote actions (lock, alarm, wipe, capture) can ONLY be executed by you using your secure owner credentials.</string>
    <string name="disclosure_guardrail_3">• Audio recording is disabled by default due to wiretapping laws. Only photo evidence is captured automatically upon unauthorized tampering.</string>
    <string name="disclosure_guardrail_4">• Android Factory Reset Protection (FRP) and carrier IMEI blacklisting are your ultimate safety net if the phone is wiped.</string>
    <string name="btn_agree_continue">I Agree &amp; Continue</string>
    <string name="btn_next">Next</string>
    <string name="btn_back">Back</string>
    <string name="btn_finish">Activate Protection</string>

    <!-- Permission Explanations (Pre-disclosure cards) -->
    <string name="perm_admin_title">Device Administrator Rights</string>
    <string name="perm_admin_desc">Required to prevent thieves from force-uninstalling the app and to enable instant remote screen lock and secure wipe.</string>
    <string name="btn_grant_admin">Grant Device Admin</string>

    <string name="perm_camera_title">Front Camera Intruder Capture</string>
    <string name="perm_camera_desc">Takes photos silently when someone enters the wrong PIN twice or attempts to tamper with the SIM or power settings.</string>
    <string name="btn_grant_camera">Allow Camera</string>

    <string name="perm_location_title">GPS &amp; Network Live Location</string>
    <string name="perm_location_desc">Tracks your phone\'s position on your private dashboard, enables safe geofencing, and transmits an emergency location ping when battery falls below 15%.</string>
    <string name="btn_grant_location">Allow Location</string>

    <string name="perm_phone_title">SIM Card &amp; Telephony State</string>
    <string name="perm_phone_desc">Detects if a thief swaps out your SIM card and immediately transmits the new phone number and location to your emergency contact.</string>
    <string name="btn_grant_phone">Allow Phone State</string>

    <string name="perm_audio_title">Emergency Audio Recording (Optional)</string>
    <string name="perm_audio_desc">Optional 10-second ambient clip on intrusion. Disabled by default due to privacy regulations. Requires explicit consent.</string>
    <string name="perm_audio_legal_warning">Legal Disclaimer: Covert audio recording of individuals without consent may violate wiretapping laws in Bangladesh and other jurisdictions. Enable only if you accept full legal responsibility.</string>

    <string name="perm_bluetooth_title">Bluetooth Nearby Finder</string>
    <string name="perm_bluetooth_desc">Enables short-range (10-30m) Bluetooth radar signal to locate your phone under furniture or in a bag via your companion dashboard.</string>

